PORT=8080
# Pasta onde ficam códigos, chat e segredo de sessão (use um volume persistente em produção)
DATA_DIR=./data
# Token para as rotas /admin (se vazio, um é gerado e mostrado no log do primeiro boot)
ADMIN_TOKEN=
# Duração do teste grátis em horas (0 desativa)
TRIAL_HOURS=1
# Planos mostrados na página: preço e link de checkout (https) do seu provedor de pagamento
PRICE_MONTHLY=
CHECKOUT_MONTHLY=
PRICE_YEARLY=
CHECKOUT_YEARLY=
PRICE_LIFETIME=
CHECKOUT_LIFETIME=
# Contato exibido quando não há planos configurados
CONTACT=
# Feeds RSS extras, separados por vírgula
EXTRA_FEEDS=
